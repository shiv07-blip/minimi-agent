# ============================================================
# Minimi — environment configuration
# Copy this file to .env and fill in your keys:  cp .env.example .env
# ============================================================

# ---- REQUIRED: LLM provider --------------------------------
# Any OpenAI-compatible API works (OpenAI, Groq, Together, OpenRouter, local vLLM...).
# Get an OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Point this at a different provider if needed (must be OpenAI-compatible).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model used for the main agent (pick the smartest you have access to).
MODEL=gpt-4o

# Smaller/cheaper model used for background memory extraction.
# Can be the same as MODEL. Falls back to MODEL when unset.
FAST_MODEL=gpt-4o-mini

# ---- STRONGLY RECOMMENDED: web search ---------------------
# Tavily is the primary search provider (LLM-friendly, returns page content).
# Free tier: https://tavily.com
TAVILY_API_KEY=tvly-...

# Optional fallback if no Tavily key. Free tier: https://brave.com/search/api/
# Without any key a keyless best-effort DuckDuckGo fallback is used (lower quality).
# BRAVE_API_KEY=

# ---- OPTIONAL: tuning (defaults shown) --------------------
# Port for the HTTP server.
# PORT=3000

# IANA timezone used to resolve dates like "Monday" / "last Tuesday".
# The browser timezone of the user is used automatically; this is the fallback.
# TIMEZONE=UTC

# Where conversations and memory are persisted.
# DATA_DIR=./data

# Search results are cached for this long (ms) — keeps repeated checks fast.
# SEARCH_CACHE_TTL_MS=600000

# Tavily search depth: "basic" (faster) or "advanced" (richer content).
# SEARCH_DEPTH=advanced

# Safety cap on tool-call rounds per message.
# MAX_TOOL_ITERATIONS=6

# How many recent messages of the current conversation are replayed to the model.
# HISTORY_MESSAGES=16

# How many recalled memory items are injected as context.
# MEMORY_MAX_ITEMS=8

# Set to 0 if your model does not support response_format json_object
# (background memory extraction degrades gracefully either way).
# JSON_MODE=1

# Log level: debug | info | warn | error.
# LOG_LEVEL=info
